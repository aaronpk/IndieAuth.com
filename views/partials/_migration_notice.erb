<% if (replacement = replacement_service) %>
<% date = migration_date %>
<% on_date = date && date.strftime('%B %-d, %Y') %>
<div class="container">
  <div class="alert alert-warning" role="alert" style="margin-bottom: 2em;">
    <% if @me && indieauth_server_user?(@scope) %>
      <%# A scope beyond profile can only come from a site that names this
          service as its own authorization server: that is where the access
          token has to come from. So this visitor definitely has work to do. %>
      <% if date %>
        <strong>A new version of IndieAuth.com is coming on <%= on_date %>.</strong>
        <%= display_url @me %> uses IndieAuth.com as its IndieAuth server, so on that day it will be
        moved over to <%= replacement.name %>, and from then on you will sign in with a passkey instead
        of a linked GitHub or email account. You can
        <a href="<%= replacement.url %>migrate">move now</a> to set that up ahead of time.
      <% else %>
        <strong><%= display_url @me %> uses IndieAuth.com as its IndieAuth server.</strong>
        This service is being replaced. You can move your site to
        <a href="<%= replacement.url %>migrate"><%= replacement.name %></a>.
      <% end %>
    <% elsif @me %>
      <%# Without such a scope this may be a site that names us, or simply an
          app using this service to sign a visitor in. Say what each should do
          rather than guessing. %>
      <% if date %>
        <strong>A new version of IndieAuth.com is coming on <%= on_date %>.</strong>
        If your own website points here as its IndieAuth server, it will be moved over to
        <%= replacement.name %> that day, and you will sign in with a passkey instead of a linked
        GitHub or email account; see <a href="<%= replacement.url %>migrate">how to move ahead of time</a>.
      <% else %>
        <strong>IndieAuth.com is being replaced.</strong>
        If your own website points here as its IndieAuth server, see
        <a href="<%= replacement.url %>migrate">how to move to <%= replacement.name %></a>.
      <% end %>
      If you are only here because an app sent you, nothing on your site needs to change — that
      app should switch to <a href="https://indielogin.com/api">IndieLogin.com</a>.
    <% else %>
      <% if date %>
        <strong>A new version of IndieAuth.com is coming on <%= on_date %>.</strong>
        Websites using it as their IndieAuth server will be moved over to
        <a href="<%= replacement.url %>"><%= replacement.name %></a> that day, or can
        <a href="<%= replacement.url %>migrate">move ahead of time</a>; developers signing users in
        should use <a href="https://indielogin.com/api">IndieLogin.com</a>.
      <% else %>
        <strong>IndieAuth.com is being replaced.</strong>
        Websites using it as their IndieAuth server can move to
        <a href="<%= replacement.url %>migrate"><%= replacement.name %></a>; developers signing users
        in should use <a href="https://indielogin.com/api">IndieLogin.com</a>.
      <% end %>
    <% end %>
  </div>
</div>
<% end %>
